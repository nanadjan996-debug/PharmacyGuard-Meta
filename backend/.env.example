# PharmacyGuard - Safe Development Environment Configuration
# Copy this file to .env for local development

PROJECT_NAME=PharmacyGuard
VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./pharmacyguard.db

# JWT Secret Key - In production, supply a 256-bit cryptographically secure random string
SECRET_KEY=pharmacyguard-hackathon-insecure-dev-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Baseten Inference Configuration (Meta Muse Spark Open)
# Provide your Baseten API key (never commit real credentials)
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_TIMEOUT_SECONDS=14.0
